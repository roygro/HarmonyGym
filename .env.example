# ==============================================================================
# HarmonyGym — Plantilla de Variables de Entorno (.env)
# Copia este archivo como .env en la raíz de HarmonyGym y completa los valores.
# ==============================================================================

# Base de datos (Neon / PostgreSQL)
DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Correo (Gmail con contraseña de aplicación de 16 caracteres)
MAIL_USERNAME=
MAIL_PASSWORD=

# PayPal Sandbox (Credenciales de Developer Dashboard)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Seguridad JWT y CORS
# Clave HMAC-SHA256 de al menos 64 caracteres
JWT_SECRET=
JWT_EXPIRACION_HORAS=8
FRONT_URL=http://localhost:4200
